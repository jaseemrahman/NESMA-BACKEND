# =============================================================================
# NESMA (NIT) PROJECT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# Django Security
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.nesma-nit.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://api.nesma-nit.com,http://127.0.0.1:8000

# PostgreSQL database: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://nesma_user:strong-password@localhost:5432/nesma
DB_CONN_MAX_AGE=60

# Cache (locmemcache://nesma for single process, redis://127.0.0.1:6379/1 for multiple workers)
CACHE_URL=locmemcache://nesma
API_CACHE_TIMEOUT=900

# CORS - Next.js frontend origins
CORS_ALLOWED_ORIGINS=https://nit-hazel.vercel.app,http://localhost:3000

# Email SMTP Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NIT <your-smtp-user@gmail.com>

# Admin notification email(s) - comma separated (receives enquiries & career applications)
ADMIN_NOTIFICATION_EMAIL=jaseemrahmanjr@gmail.com

# Public API form submissions limit per IP
SUBMISSION_THROTTLE_RATE=10/hour
CV_MAX_SIZE_MB=5

# URLs
SITE_URL=https://api.nesma-nit.com
# Domain that serves /media/ (images in API responses are returned as full https URLs)
MEDIA_DOMAIN=https://api.nesma-nit.com
FRONTEND_URL=https://nit-hazel.vercel.app
